// SPDX-License-Identifier: Apache-2.0
//
// Cloudflare Worker "koinon-docs": static assets only. There is no `main` entry and no Worker code;
// Cloudflare serves the Astro build output. Cloudflare builds from GitHub (Workers Builds), so no
// deploy step lives in this repository's CI. Keys checked against
// https://developers.cloudflare.com/workers/wrangler/configuration/#assets on 2026-11-10.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koinon-docs",
  "compatibility_date": "2026-11-10",
  // The public address. A production deploy attaches it: Cloudflare makes the DNS record and the
  // certificate. The zone stateracloud.com is in the same Cloudflare account.
  "routes": [{ "pattern": "koinon.stateracloud.com", "custom_domain": true }],
  // Production is served at the address above only, not at a workers.dev name. Each pull request
  // still gets a preview address (`wrangler versions upload`).
  "workers_dev": false,
  "preview_urls": true,
  // Workers Builds runs `wrangler preview` for a branch that is not `main`. That command needs this
  // block; it stays empty because a preview has no settings of its own (wrangler 4.135.0 or later).
  // https://developers.cloudflare.com/workers/previews/configuration/ read on 2026-11-10.
  "previews": {},
  "assets": {
    "directory": "./dist",
    // A request that matches no file gets the nearest 404.html with status 404.
    "not_found_handling": "404-page"
  }
}
